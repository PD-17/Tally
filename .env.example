# Copy to .env and fill in. .env is git-ignored; never commit it.

# Crustdata key from app.crustdata.com (Settings -> API keys)
CRUSTDATA_API_KEY=

# Anthropic key. Without it, Tally reads jobs and titles with its rules only.
ANTHROPIC_API_KEY=

# Rupees per US dollar, for the quote and the bill (e.g. 88)
TALLY_INR_PER_USD=

# live | record | replay | fake. "record" is live and also saves every response for replay.
TALLY_MODE=record

# Where the ledger and saved responses go
TALLY_DATA_DIR=data

# What one credit is worth in USD (the event values 15,000 credits at $4,500)
TALLY_USD_PER_CREDIT=0.30
